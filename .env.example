# Copia este archivo a .env y rellena lo que uses.
# Ninguna variable es obligatoria: sin ellas la app arranca igual y
# las funciones que dependen de cada una se apagan solas y lo dicen.

# Puerto del servidor
PORT=3000

# Dónde vive la base SQLite
DATABASE_PATH=./data/distriaves.db

# Usuario inicial. Si no pones ADMIN_PASS, se genera una contraseña y
# se imprime UNA SOLA VEZ en la consola del primer arranque.
ADMIN_USER=olga
# ADMIN_PASS=pon-aqui-una-clave-larga

# Copia del paquete enviado a un chat de Telegram (opcional).
# Cómo sacar los dos valores: README, sección "Copia del paquete".
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=

# Transcripción de casillas (opcional). Sin esta llave el botón
# "Leer las casillas" avisa de que falta y no se llama a nadie.
# La llave NO baja al navegador: se queda en el servidor.
# ANTHROPIC_API_KEY=
# OCR_MODELO=claude-sonnet-5
